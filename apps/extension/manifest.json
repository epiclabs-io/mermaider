{
  "manifest_version": 3,
  "name": "Mermaider",
  "version": "0.1.0",
  "description": "Interactive Mermaid diagrams for Claude and GitHub, with pan, zoom, maximize and source controls.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["detect.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*", "https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
